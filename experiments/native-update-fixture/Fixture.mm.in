#include "SharedWidgets.h"
#include "Appearance.h"
#include "Preferences.h"
#include <QApplication>
#include <QCoreApplication>
#include <QDir>
#include <QFile>
#include <QFileInfo>
#include <QJsonArray>
#include <QJsonDocument>
#include <QNetworkAccessManager>
#include <QNetworkReply>
#include <QNetworkRequest>
#include <QSaveFile>
#include <QTimer>
#include <cstdio>
#include <cstring>
#include <memory>
namespace {
int networkRequests = 0;
QString directory() { return QString::fromUtf8(@DIRECTORY@); }
QJsonObject config() { QFile file(directory()+"/configuration.json"); if (!file.open(QIODevice::ReadOnly) || file.size()>65536) return {}; return QJsonDocument::fromJson(file.readAll()).object(); }
bool write(const QString &name,const QJsonObject &value) { QSaveFile file(directory()+'/'+name); auto bytes=QJsonDocument(value).toJson(); return file.open(QIODevice::WriteOnly)&&file.write(bytes)==bytes.size()&&file.commit(); }
void fail(const QString &error) {
    write("error.json",{{"error",error},{"build",xdnote::BuildInfo::buildNumber()}});
    const auto exit=[] { QCoreApplication::exit(50); };
    if (!deferMacUpdateQuit(exit)) QTimer::singleShot(0,qApp,exit);
}
class Reply final : public QNetworkReply {
    QByteArray bytes; qint64 offset=0;
public:
    Reply(const QNetworkRequest &request, const QString &path, QObject *parent):QNetworkReply(parent) {
        setRequest(request);setUrl(request.url());setOperation(QNetworkAccessManager::GetOperation);
        QFile file(path);const bool ok=!QFileInfo(path).isSymLink()&&file.open(QIODevice::ReadOnly)&&file.size()<8*1024*1024;
        if(ok)bytes=file.readAll(); else setError(ContentNotFoundError,"Missing private fixture route");
        setAttribute(QNetworkRequest::HttpStatusCodeAttribute,ok?200:404);open(QIODevice::ReadOnly|QIODevice::Unbuffered);
        QTimer::singleShot(0,this,[this]{emit readyRead();if(!isFinished()){setFinished(true);emit finished();}});
    }
    qint64 bytesAvailable()const override{return bytes.size()-offset+QIODevice::bytesAvailable();}
    void abort()override{if(!isFinished()){setError(OperationCanceledError,"Private fixture abort");setFinished(true);emit finished();}}
protected:qint64 readData(char *data,qint64 size)override{const auto n=qMin(size,qint64(bytes.size()-offset));if(n<=0)return -1;std::memcpy(data,bytes.constData()+offset,size_t(n));offset+=n;return n;}
};
class Network final:public QNetworkAccessManager {
public:using QNetworkAccessManager::QNetworkAccessManager;
protected:QNetworkReply *createRequest(Operation operation,const QNetworkRequest &request,QIODevice *data)override{
    Q_UNUSED(data); ++networkRequests; auto name=config()["routes"].toObject().value(request.url().toString()).toString();
    if(operation!=GetOperation||name.isEmpty()||QFileInfo(name).fileName()!=name||name.contains('\\')||name=="..")name="missing-fixture-route";
    return new Reply(request,directory()+'/'+name,this);
}
};
}
QNetworkAccessManager *fixtureNetwork(QObject *parent){return new Network(parent);}
QString fixtureRoot(){return QDir(QCoreApplication::applicationDirPath()+"/../..").canonicalPath();}
QString fixtureFeed(){return config()["server"].toString()+"appcast.xml";}
QString fixtureArchive(){return config()["server"].toString()+"archive.app.zip";}
void fixtureBoot(QApplication *application){
    application->setQuitOnLastWindowClosed(false);
    const auto mode=config()["mode"].toString();
    if(mode!="cancel"&&mode!="install"&&mode!="discard"&&mode!="corrupt"&&mode!="recovery"&&mode!="network"){fail("invalid_fixture_mode");return;}
    auto *desktop=new xdnote::FileApplication(application,directory()+"/settings.json",xdnote::FileApplication::Presentation::HiddenNative);
    QObject::connect(application,&QCoreApplication::aboutToQuit,desktop,[desktop]{delete desktop;});
    auto *updates=desktop->findChild<xdnote::UpdateController *>();
    if(!updates){fail("missing_controller");return;}
    if(mode=="recovery") {
        const bool expected=updates->state()=="recovery_required" && networkRequests==0;
        write("recovery.json",{{"ok",expected},{"state",updates->state()},{"automaticRequests",networkRequests},{"build",xdnote::BuildInfo::buildNumber()}});
        QTimer::singleShot(0,application,[expected]{QCoreApplication::exit(expected?0:53);});return;
    }
    if(xdnote::BuildInfo::buildNumber()==201){
        QFile document(directory()+"/owned.md"),settings(directory()+"/settings.json"),recovery(directory()+"/settings.json.recovery");
        const bool documentOk=document.open(QIODevice::ReadOnly)&&document.readAll()==QByteArray(mode=="discard"?"owned\n":"edited owned\n");
        const bool discardOk=mode!="discard"||(recovery.open(QIODevice::ReadOnly)&&([&]{const auto drafts=QJsonDocument::fromJson(recovery.readAll()).object()["drafts"].toArray();return drafts.size()==1&&drafts[0].toObject()["id"]=="11111111-1111-4111-8111-111111111111"&&QByteArray::fromBase64(drafts[0].toObject()["content"].toString().toLatin1())==QByteArray("owned unrelated recovery\n");})());
        const bool settingsOk=settings.open(QIODevice::ReadOnly)&&QJsonDocument::fromJson(settings.readAll()).object().value("fixtureUnknown").toString()=="retained";
        const bool updated=updates->state()=="updated";
        write("restarted.json",{{"ok",documentOk&&settingsOk&&updated&&discardOk},{"documentPreserved",documentOk},{"unknownSettingPreserved",settingsOk},{"discardedDraftAbsent",discardOk},
              {"version",xdnote::BuildInfo::version()},{"build",xdnote::BuildInfo::buildNumber()},{"revision",xdnote::BuildInfo::revision()},
              {"updateState",updates->state()},{"executable",QCoreApplication::applicationFilePath()}});
        QTimer::singleShot(0,application,[updated]{QCoreApplication::exit(updated?0:51);});return;
    }
    desktop->open(directory()+"/owned.md");
    auto *timer=new QTimer(desktop);timer->setInterval(20);
    auto pane=std::make_shared<QPointer<xdnote::SingleFileWindow>>(); auto started=std::make_shared<bool>(false); auto finished=std::make_shared<bool>(false);
    QObject::connect(timer,&QTimer::timeout,desktop,[=]{
        for(auto widget:QApplication::topLevelWidgets()){
            if(widget->objectName()=="unsavedConfirmation"){
                if(auto button=widget->findChild<xdnote::SharedButton *>(mode=="cancel"?"choice0":mode=="discard"?"choice2":"choice1"))button->click();
            }
            if(auto value=qobject_cast<xdnote::SingleFileWindow *>(widget))if(value->document()&&value->document()->path()==directory()+"/owned.md")*pane=value;
        }
        if(*started||!*pane)return;
        auto session=(*pane)->document()->session();
        if(session->replace(0,0,"edited ",session->revision())!=xdnote::EditResult::Applied){fail("edit_failed");return;}
        if(!(*pane)->appearance()->setPreferences("dark","graphite")){fail("settings_failed");return;}
        *started=true;updates->check();
    });timer->start();
    QObject::connect(updates,&xdnote::UpdateController::changed,desktop,[=]{
        write("status.json",{{"state",updates->state()},{"error",updates->errorCode()},{"trusted",updates->trusted()},{"native",macUpdateExitStatus()}});
        if(*finished)return;
        if(updates->state()=="error"||updates->state()=="recovery_required"){
            *finished=true;
            if(mode!="corrupt"&&mode!="network"){fail("controller_"+updates->errorCode());return;}
            const auto settle=[=]{
                bool buffer=bool(*pane)&&(*pane)->document()->session()->snapshot().utf8==QByteArray("edited owned\n");
                QFile file(directory()+"/owned.md");bool disk=file.open(QIODevice::ReadOnly)&&file.readAll()==QByteArray("owned\n");
                write("corrupt.json",{{"ok",buffer&&disk},{"bufferPreserved",buffer},{"diskPreserved",disk},{"state",updates->state()},{"error",updates->errorCode()},{"native",macUpdateExitStatus()}});
                QCoreApplication::exit(buffer&&disk?0:54);
            };
            if(!deferMacUpdateQuit(settle))settle();return;
        }
        if(updates->state()=="available"&&updates->trusted()&&updates->errorCode().isEmpty()){
            QTimer::singleShot(0,updates,&xdnote::UpdateController::install);
        }else if(mode=="cancel"&&updates->state()=="available"&&updates->errorCode()=="cancelled"){
            *finished=true;
            const auto finish=[=]{
                bool preserved=bool(*pane);bool undo=false;
                if(*pane){auto session=(*pane)->document()->session();preserved=session->snapshot().utf8==QByteArray("edited owned\n");undo=session->undo()==xdnote::EditResult::Applied&&session->snapshot().utf8==QByteArray("owned\n");}
                QFile file(directory()+"/owned.md");const bool disk=file.open(QIODevice::ReadOnly)&&file.readAll()==QByteArray("owned\n");
                write("cancelled.json",{{"ok",preserved&&undo&&disk},{"bufferPreserved",preserved},{"undoPreserved",undo},{"diskPreserved",disk},{"native",macUpdateExitStatus()}});
                QCoreApplication::exit(preserved&&undo&&disk?0:52);
            };
            if(!deferMacUpdateQuit(finish))finish();
        }
    });
    QTimer::singleShot(120000,application,[]{fail("fixture_timeout");});
}

void fixtureNativeError(const QString &domain, qint64 code, const QString &description, const QString &reason) { write("native-error.json",{{"domain",domain},{"code",code},{"description",description},{"reason",reason}}); }
