// Standalone CI process image, never an xdnote product executable.
use std::{fs, path::Path, thread, time::{Duration, Instant}};
const IDENTITY: &str = @IDENTITY@;
const RESTARTED: &str = @RESTARTED@;

#[cfg(target_os = "linux")]
fn usage_gate() -> fs::File {
    use std::os::fd::AsRawFd;
    unsafe extern "C" { fn flock(fd: i32, operation: i32) -> i32; }
    let file = fs::File::open("/run/xdnote/usage.lock").unwrap();
    assert_eq!(unsafe { flock(file.as_raw_fd(), 1 | 4) }, 0);
    file
}
#[cfg(windows)]
fn usage_gate() -> *mut std::ffi::c_void {
    #[link(name = "kernel32")]
    unsafe extern "system" { fn CreateMutexW(attributes: *const u8, owner: i32, name: *const u16) -> *mut std::ffi::c_void; }
    let name: Vec<_> = "Local\\xdnote.desktop.running".encode_utf16().chain(Some(0)).collect();
    let handle = unsafe { CreateMutexW(std::ptr::null(), 0, name.as_ptr()) };
    assert!(!handle.is_null());
    handle
}
fn main() {
    let args: Vec<_> = std::env::args().collect();
    if args.get(1).map(String::as_str) == Some("--version-json") { println!("{IDENTITY}"); return; }
    if args.get(1).map(String::as_str) != Some("--wait") { fs::write(RESTARTED, IDENTITY).unwrap(); return; }
    let directory = Path::new(&args[2]);
    let _gate = usage_gate();
    fs::write(directory.join("parent-ready"), std::process::id().to_string()).unwrap();
    let deadline = Instant::now() + Duration::from_secs(180);
    while !directory.join("stop-parent").exists() && Instant::now() < deadline { thread::sleep(Duration::from_millis(25)); }
}
