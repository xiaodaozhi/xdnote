+
+// Windows' generic close notifier temporarily removes readBufferMaxSize.
+// Keep that policy out of the bounded SOCKS5 transport without changing any
+// existing Qt private class layout used by separately built TLS plugins.
+class QSocks5ControlSocketPrivate final : public QTcpSocketPrivate
+{
+public:
+    bool closePending = false;
+    bool closeQueued = false;
+
+    void connectionNotification() override
+    {
+        closePending = closeQueued = false;
+        QTcpSocketPrivate::connectionNotification();
+    }
+
+    void closeNotification() override
+    {
+        closeQueued = false;
+        closePending = true;
+        if (socketEngine)
+            canReadNotification(); // respects the configured buffer bound
+    }
+
+    void queueCloseAfterRead()
+    {
+        if (closePending && !closeQueued && socketEngine
+            && state == QAbstractSocket::ConnectedState
+            && (!readBufferMaxSize || buffer.size() < readBufferMaxSize)) {
+            closeQueued = true;
+            QMetaObject::invokeMethod(socketEngine, "closeNotification", Qt::QueuedConnection);
+        }
+    }
+};
+
+class QSocks5ControlSocket final : public QTcpSocket
+{
+    Q_DECLARE_PRIVATE(QSocks5ControlSocket)
+public:
+    explicit QSocks5ControlSocket(QObject *parent)
+        : QTcpSocket(*new QSocks5ControlSocketPrivate, parent) {}
+
+protected:
+    qint64 readData(char *data, qint64 maxSize) override
+    {
+        const qint64 result = QTcpSocket::readData(data, maxSize);
+        d_func()->queueCloseAfterRead();
+        return result;
+    }
+};
 
 static const int MaxWriteBufferSize = 128*1024;
 
