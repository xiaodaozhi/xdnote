+                userInfo:@{NSLocalizedDescriptionKey: @"The update transport is unsupported or cannot be changed after starting the updater."}];
+        }
+        return NO;
+    }
+    if (SPUXdnoteCreateDownloadConfiguration(mode, proxyURL, error) == nil) {
+        return NO;
+    }
+    _host.xdnoteDownloadProxyURL = proxyURL;
+    _host.xdnoteDownloadDirect = mode == SPUXdnoteDownloadProxyDirect;
+    return YES;
+}
