+static NSURLSessionConfiguration * _Nullable SPUPACError(NSString *reason, NSError * _Nullable cause, NSError * __autoreleasing *error)
+{
+    if (error != NULL) {
+        NSMutableDictionary *info = [@{NSLocalizedDescriptionKey: reason} mutableCopy];
+        if (cause != nil) {
+            info[NSUnderlyingErrorKey] = cause;
+        }
+        *error = [NSError errorWithDomain:SUSparkleErrorDomain code:SUDownloadError userInfo:info];
+    }
+    return nil;
+}
+
+static void SPUPACDidResolve(void *context, CFArrayRef routes, CFErrorRef error)
+{
+    void (^completion)(CFArrayRef, CFErrorRef) = (__bridge void (^)(CFArrayRef, CFErrorRef))context;
+    completion(routes, error);
+}
+
+// Called off the main thread. Keep one bounded native evaluation for each request,
+// and invalidate the source on cancellation before the downloader can start a task.
+static NSURLSessionConfiguration * _Nullable SPUResolveSystemDownloadConfiguration(NSURL *target, NSProgress *operation, NSError * __autoreleasing *error)
+{
+    NSDictionary *settings = CFBridgingRelease(CFNetworkCopySystemProxySettings());
+    BOOL enabled = [settings[(__bridge NSString *)kCFNetworkProxiesProxyAutoConfigEnable] boolValue];
+    NSString *source = nil;
+    NSURL *scriptURL = nil;
+    if (enabled) {
+        source = settings[(__bridge NSString *)kCFNetworkProxiesProxyAutoConfigJavaScript];
+        NSString *address = settings[(__bridge NSString *)kCFNetworkProxiesProxyAutoConfigURLString];
+        if ([address isKindOfClass:NSString.class]) {
+            scriptURL = [NSURL URLWithString:address];
+        }
+    } else if (settings != nil) {
+        // CFNetwork may surface a PAC route even when it isn't a global setting.
+        NSArray *entries = CFBridgingRelease(CFNetworkCopyProxiesForURL((__bridge CFURLRef)target, (__bridge CFDictionaryRef)settings));
+        NSDictionary *first = entries.firstObject;
+        NSString *type = first[(__bridge NSString *)kCFProxyTypeKey];
+        if ([type isEqual:(__bridge NSString *)kCFProxyTypeAutoConfigurationURL]) {
+            enabled = YES;
+            scriptURL = first[(__bridge NSString *)kCFProxyAutoConfigurationURLKey];
+        } else if ([type isEqual:(__bridge NSString *)kCFProxyTypeAutoConfigurationJavaScript]) {
+            enabled = YES;
+            source = first[(__bridge NSString *)kCFProxyAutoConfigurationJavaScriptKey];
+        }
+    }
+    if (!enabled) {
+        return SPUXdnoteCreateDownloadConfiguration(SPUXdnoteDownloadProxySystem, nil, error);
+    }
+
+    BOOL hasSource = [source isKindOfClass:NSString.class] && source.length > 0;
+    BOOL hasURL = [scriptURL isKindOfClass:NSURL.class] && scriptURL.scheme.length > 0;
+    if (!hasSource && !hasURL) {
+        return SPUPACError(@"System update proxy configuration has no usable PAC script.", nil, error);
+    }
+
+    __block BOOL finished = NO;
+    __block NSArray *routes = nil;
+    __block NSError *cause = nil;
+    __attribute__((objc_precise_lifetime)) void (^completion)(CFArrayRef, CFErrorRef) = ^(CFArrayRef list, CFErrorRef failure) {
+        routes = [(__bridge NSArray *)list copy];
+        cause = (__bridge NSError *)failure;
+        finished = YES;
+    };
+    CFStreamClientContext context = {0, (__bridge void *)completion, NULL, NULL, NULL};
+    CFRunLoopSourceRef runSource = hasSource
+        ? CFNetworkExecuteProxyAutoConfigurationScript((__bridge CFStringRef)source, (__bridge CFURLRef)target, SPUPACDidResolve, &context)
+        : CFNetworkExecuteProxyAutoConfigurationURL((__bridge CFURLRef)scriptURL, (__bridge CFURLRef)target, SPUPACDidResolve, &context);
+    if (runSource != NULL) {
+        CFStringRef runMode = CFSTR("org.xdnote.sparkle.pac");
+        CFRunLoopAddSource(CFRunLoopGetCurrent(), runSource, runMode);
+        NSTimeInterval deadline = NSProcessInfo.processInfo.systemUptime + 10.0;
+        while (!finished && !operation.cancelled) {
+            NSTimeInterval remaining = deadline - NSProcessInfo.processInfo.systemUptime;
+            if (remaining <= 0) {
+                break;
+            }
+            CFRunLoopRunInMode(runMode, MIN(remaining, 0.1), true);
+        }
+        CFRunLoopSourceInvalidate(runSource);
+        CFRelease(runSource);
+    }
+
+    NSDictionary *route = routes.firstObject;
+    if (!finished || cause != nil || ![route isKindOfClass:NSDictionary.class]) {
+        return SPUPACError(@"Could not resolve the system PAC route for the update.", cause, error);
+    }
+
+    // Use the first route actually returned by PAC. A failed proxy must not
+    // activate a second route implicitly, even if NSURLSession normally would.
+    NSString *type = route[(__bridge NSString *)kCFProxyTypeKey];
+    if ([type isEqual:(__bridge NSString *)kCFProxyTypeNone]) {
+        return SPUXdnoteCreateDownloadConfiguration(SPUXdnoteDownloadProxyDirect, nil, error);
+    }
+
+    NSString *scheme = nil;
+    // CFNetwork labels a plain PROXY directive for an HTTPS origin as HTTPS.
+    if ([type isEqual:(__bridge NSString *)kCFProxyTypeHTTP] || [type isEqual:(__bridge NSString *)kCFProxyTypeHTTPS]) {
+        scheme = @"http";
+    } else if ([type isEqual:(__bridge NSString *)kCFProxyTypeSOCKS] &&
+               [route[(__bridge NSString *)kCFStreamPropertySOCKSVersion] isEqual:(__bridge NSString *)kCFStreamSocketSOCKSVersion5]) {
+        scheme = @"socks5";
+    }
+    NSString *host = route[(__bridge NSString *)kCFProxyHostNameKey];
+    NSNumber *port = route[(__bridge NSString *)kCFProxyPortNumberKey];
+    if (scheme == nil || ![host isKindOfClass:NSString.class] || host.length == 0 ||
+        ![port isKindOfClass:NSNumber.class] || port.longLongValue <= 0 || port.longLongValue > 65535) {
+        return SPUPACError(@"The system PAC route is not a supported update proxy.", nil, error);
+    }
+    NSURLComponents *components = [NSURLComponents new];
+    components.scheme = scheme;
+    components.host = host;
+    components.port = port;
+    NSURL *proxy = components.URL;
+    if (proxy == nil) {
+        return SPUPACError(@"The system PAC returned an invalid update proxy address.", nil, error);
+    }
+    return SPUXdnoteCreateDownloadConfiguration(SPUXdnoteDownloadProxyCustom, proxy, error);
+}
 
