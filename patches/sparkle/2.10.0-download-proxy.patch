+NSURLSessionConfiguration * _Nullable SPUXdnoteCreateDownloadConfiguration(SPUXdnoteDownloadProxyMode mode, NSURL * _Nullable proxyURL, NSError * __autoreleasing *error)
+{
+    BOOL valid = (mode == SPUXdnoteDownloadProxySystem || mode == SPUXdnoteDownloadProxyDirect || mode == SPUXdnoteDownloadProxyCustom) &&
+        ((mode == SPUXdnoteDownloadProxyCustom) == (proxyURL != nil));
+    if (proxyURL != nil) {
+        NSString *scheme = proxyURL.scheme.lowercaseString;
+        long long port = proxyURL.port.longLongValue;
+        valid = valid && ([scheme isEqualToString:@"http"] || [scheme isEqualToString:@"socks5"]) &&
+            proxyURL.host.length > 0 && port > 0 && port <= 65535 &&
+            proxyURL.user == nil && proxyURL.password == nil && proxyURL.query == nil &&
+            proxyURL.fragment == nil && (proxyURL.path.length == 0 || [proxyURL.path isEqualToString:@"/"]);
+    }
+    if (!valid) {
+        if (error != NULL) *error = [NSError errorWithDomain:SUSparkleErrorDomain code:SUInvalidUpdaterError
+            userInfo:@{NSLocalizedDescriptionKey: @"Invalid update transport configuration."}];
+        return nil;
+    }
+    NSURLSessionConfiguration *configuration = [NSURLSessionConfiguration ephemeralSessionConfiguration];
+    configuration.TLSMinimumSupportedProtocolVersion = tls_protocol_version_TLSv12;
+    configuration.timeoutIntervalForRequest = 30;
+    configuration.timeoutIntervalForResource = 3600;
+    configuration.HTTPCookieStorage = nil;
+    configuration.HTTPCookieAcceptPolicy = NSHTTPCookieAcceptPolicyNever;
+    configuration.HTTPShouldSetCookies = NO;
+    configuration.URLCredentialStorage = nil;
+    configuration.URLCache = nil;
+    if (mode == SPUXdnoteDownloadProxyDirect) {
+        // A non-nil, explicit dictionary overrides system settings. An empty
+        // proxyConfigurations array would instead retain the system policy.
+        configuration.connectionProxyDictionary = @{
+            (__bridge NSString *)kCFNetworkProxiesHTTPEnable: @0,
+            (__bridge NSString *)kCFNetworkProxiesHTTPSEnable: @0,
+            (__bridge NSString *)kCFNetworkProxiesSOCKSEnable: @0,
+            (__bridge NSString *)kCFNetworkProxiesFTPEnable: @0,
+            (__bridge NSString *)kCFNetworkProxiesProxyAutoConfigEnable: @0,
+            (__bridge NSString *)kCFNetworkProxiesProxyAutoDiscoveryEnable: @0
+        };
+    } else if (proxyURL != nil) {
+        if (@available(macOS 14.0, *)) {
+            NSString *host = proxyURL.host;
+            if ([host hasPrefix:@"["] && [host hasSuffix:@"]"]) {
+                host = [host substringWithRange:NSMakeRange(1, host.length - 2)];
+            }
+            nw_endpoint_t endpoint = nw_endpoint_create_host(host.UTF8String, proxyURL.port.stringValue.UTF8String);
+            nw_proxy_config_t proxy = [proxyURL.scheme.lowercaseString isEqualToString:@"http"]
+                ? nw_proxy_config_create_http_connect(endpoint, nil)
+                : nw_proxy_config_create_socksv5(endpoint);
+            if (proxy == nil) {
+                if (error != NULL) *error = [NSError errorWithDomain:SUSparkleErrorDomain code:SUDownloadError
+                    userInfo:@{NSLocalizedDescriptionKey: @"The update proxy configuration could not be created."}];
+                return nil;
+            }
+            // A failed explicit proxy must never bypass the user's network choice.
+            nw_proxy_config_set_failover_allowed(proxy, false);
+            configuration.proxyConfigurations = @[proxy];
+        } else {
+            if (error != NULL) *error = [NSError errorWithDomain:SUSparkleErrorDomain code:SUDownloadError
+                userInfo:@{NSLocalizedDescriptionKey: @"The explicit update proxy requires macOS 14 or later."}];
+            return nil;
+        }
+    }
+    return configuration;
+}
 
