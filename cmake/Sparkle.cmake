# Configuration verifies explicitly prepared inputs; it never downloads a SDK.
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/scripts/sparkle.py" verify
    OUTPUT_VARIABLE XDNOTE_SPARKLE_PATH OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set(XDNOTE_SPARKLE_SDK "${PROJECT_SOURCE_DIR}/${XDNOTE_SPARKLE_PATH}")
unset(XDNOTE_SPARKLE_FRAMEWORK CACHE)
find_library(XDNOTE_SPARKLE_FRAMEWORK NAMES Sparkle PATHS "${XDNOTE_SPARKLE_SDK}" NO_DEFAULT_PATH REQUIRED)
